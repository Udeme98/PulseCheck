generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorStatus {
  ACTIVE
  PAUSED
}

enum CheckStatus {
  UP
  DOWN
}

enum MonitorHealthStatus {
  UNKNOWN
  UP
  DOWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monitors Monitor[]
}

model Monitor {
  id                  String              @id @default(cuid())
  name                String
  url                 String
  intervalSeconds     Int                 @default(300)
  status              MonitorStatus       @default(ACTIVE)
  healthStatus        MonitorHealthStatus @default(UNKNOWN)
  consecutiveFailures Int                 @default(0)
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults CheckResult[]
  incidents    Incident[]

  @@index([userId])
  @@index([status, nextCheckAt])
}

model CheckResult {
  id             String      @id @default(cuid())
  status         CheckStatus
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime    @default(now())

  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
}

model Incident {
  id         String   @id @default(cuid())
  startedAt  DateTime @default(now())
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([monitorId, startedAt])
  @@index([monitorId, resolvedAt])
}

enum NotificationType {
  INCIDENT_OPENED
  INCIDENT_RESOLVED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Notification {
  id                  String             @id @default(cuid())
  type                NotificationType
  status              NotificationStatus @default(PENDING)

  recipient           String
  payload             Json

  attempts            Int                @default(0)
  maxAttempts         Int                @default(5)
  nextAttemptAt       DateTime           @default(now())

  processingStartedAt DateTime?
  sentAt              DateTime?
  lastError           String?            @db.Text

  deduplicationKey    String             @unique

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  incidentId          String?
  incident            Incident?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([incidentId])
}