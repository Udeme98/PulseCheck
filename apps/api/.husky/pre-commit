#!/usr/bin/env sh
# PulseCheck API pre-commit checks
# Runs from the repo root; cd into apps/api so npm scripts resolve correctly.

cd apps/api

echo "▶ [1/3] Linting (oxlint)..."
npm run lint
if [ $? -ne 0 ]; then
  echo "✖ Lint failed. Commit blocked."
  exit 1
fi

echo "▶ [2/3] Checking formatting (prettier)..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "✖ Prettier check failed. Run 'npm run format' to fix, then re-stage."
  exit 1
fi

echo "▶ [3/3] TypeScript build (nest build)..."
npm run build
if [ $? -ne 0 ]; then
  echo "✖ Build failed. Fix TypeScript errors before committing."
  exit 1
fi

echo "✔ All checks passed."
